# Ghostty config — mirrors wezterm/wezterm.lua
# Symlinked: ~/.config/ghostty -> ~/dot-files/ghostty
# Reload with ctrl+shift+, | list options: ghostty +show-config --default --docs

command = /usr/bin/zsh

# Appearance
theme = Catppuccin Mocha
font-family = JetBrains Mono
font-style = Medium
font-size = 14
font-feature = -calt
font-feature = -liga
font-feature = -clig

window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
background-opacity = 1

cursor-style = bar
cursor-style-blink = true

# Dim unfocused splits
unfocused-split-opacity = 0.8

# Bell: flash instead of sound
bell-features = no-audio,attention,title

confirm-close-surface = false
copy-on-select = clipboard
# Use the widely supported xterm-256color terminal type over SSH.
shell-integration-features = no-cursor,ssh-env

# Keybinds — macOS-style: alt plays the role of cmd (super belongs to Hyprland)
# Ghostty's ctrl+shift defaults (ctrl+shift+c/v, ctrl+shift+t, ...) still work too.

# Clipboard (performable: alt+c only copies when there's a selection, else passes through)
keybind = performable:alt+c=copy_to_clipboard:mixed
keybind = alt+v=paste_from_clipboard
keybind = alt+a=select_all

# Windows & tabs
keybind = alt+n=new_window
keybind = alt+t=new_tab
keybind = alt+w=close_surface
keybind = alt+shift+w=close_tab:this
keybind = alt+q=quit
keybind = alt+shift+bracket_left=previous_tab
keybind = alt+shift+bracket_right=next_tab
keybind = alt+ctrl+arrow_left=previous_tab
keybind = alt+ctrl+arrow_right=next_tab
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=last_tab

# Splits
keybind = alt+d=new_split:right
keybind = alt+shift+d=new_split:down
keybind = alt+arrow_left=goto_split:left
keybind = alt+arrow_right=goto_split:right
keybind = alt+arrow_up=goto_split:up
keybind = alt+arrow_down=goto_split:down
keybind = alt+bracket_left=goto_split:previous
keybind = alt+bracket_right=goto_split:next
keybind = alt+shift+arrow_left=resize_split:left,20
keybind = alt+shift+arrow_right=resize_split:right,20
keybind = alt+shift+arrow_up=resize_split:up,20
keybind = alt+shift+arrow_down=resize_split:down,20
keybind = alt+shift+enter=toggle_split_zoom

# View
keybind = alt+k=clear_screen
keybind = alt+f=start_search
keybind = alt+ctrl+f=toggle_fullscreen
keybind = alt+shift+p=toggle_command_palette
keybind = alt+equal=increase_font_size:1
keybind = alt+minus=decrease_font_size:1
keybind = alt+0=reset_font_size
keybind = alt+comma=open_config
keybind = alt+shift+comma=reload_config
